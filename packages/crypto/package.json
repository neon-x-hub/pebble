{
  "name": "@pebbl/crypto",
  "version": "0.1.1",
  "description": "Ed25519 cryptography, canonical JSON encoding, and signature verification for Pebble",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neon-x-hub/pebble.git",
    "directory": "packages/crypto"
  },
  "keywords": [
    "pebble",
    "crypto",
    "ed25519",
    "signatures",
    "canonical-json",
    "security"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "node --eval \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@pebbl/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
