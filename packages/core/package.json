{
  "name": "@pebbl/core",
  "version": "0.1.0",
  "description": "In-memory store, Last-Write-Wins conflict resolution, append-only log persistence, and recovery for Pebble",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neon-x-hub/pebble.git",
    "directory": "packages/core"
  },
  "keywords": [
    "pebble",
    "store",
    "lww",
    "conflict-resolution",
    "persistence",
    "event-sourcing",
    "log"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "node --eval \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@pebbl/crypto": "workspace:*",
    "@pebbl/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
