{
  "name": "@pebbl/node",
  "version": "0.1.1",
  "description": "Full cluster peer node runtime, gossip replication engine, and client server for Pebble",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neon-x-hub/pebble.git",
    "directory": "packages/node"
  },
  "keywords": [
    "pebble",
    "node",
    "gossip",
    "peer-to-peer",
    "server",
    "distributed-database"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "node --eval \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@pebbl/core": "workspace:*",
    "@pebbl/crypto": "workspace:*",
    "@pebbl/types": "workspace:*",
    "@pebbl/wire": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
